# Public template: replace placeholders locally; never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Server-only, used by Telegram session storage and reminders.
SUPABASE_SERVICE_ROLE_KEY=
# Restricted fluxo_runtime login through the Supabase transaction pooler.
DATABASE_URL=postgresql://fluxo_runtime.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Gemini and market integrations (server-only).
GEMINI_API_KEY=
GEMINI_MODEL=
FMP_API_KEY=
# Telegram: numeric sender ID maps to an authenticated Supabase UUID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_USER_LINKS={"123456789":"11111111-1111-4111-8111-111111111111"}
# Optional additional legacy allowlist; it does not replace the mapping above.
TELEGRAM_ALLOWED_USERS=
# A long random value: Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
